[Unit]
Description=Factor Combination Optimizer - Daily Precompute
After=network.target
Documentation=https://github.com/openclaw/factor_ic_analyzer

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/projects/factor_ic_analyzer

# 使用虚拟环境中的 Python
ExecStart=/home/admin/projects/factor_ic_analyzer/.venv/bin/python precompute_optimizer.py

# 日志输出
StandardOutput=append:/home/admin/projects/factor_ic_analyzer/logs/optimizer.log
StandardError=append:/home/admin/projects/factor_ic_analyzer/logs/optimizer_error.log

# 内存限制（适配 3.5GB 服务器）
MemoryMax=2G
MemoryHigh=1.5G

# CPU限制（避免占用过多资源）
CPUQuota=80%

# 超时设置（3小时后自动终止）
TimeoutStartSec=10800
TimeoutStopSec=300

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="LANG=en_US.UTF-8"

[Install]
WantedBy=multi-user.target